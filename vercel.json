{
  "builds": [
    {
      "src": "construction_company/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "construction_company/wsgi.py"
    }
  ],
  "env": {
    "DATABASE_URL": "@database-url",
    "SUPABASE_URL": "@supabase-url",
    "SUPABASE_ANON_KEY": "@supabase-anon-key",
    "VERCEL_ENVIRONMENT": "production"
  }
}